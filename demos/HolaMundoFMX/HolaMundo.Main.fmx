object frmHolaMundo: TfrmHolaMundo
  Caption = 'Hola mundo'
  ClientHeight = 300
  ClientWidth = 480
  Position = ScreenCenter
  object btnHolaMundo: TButton
    Align = Center
    Size.Width = 180.000000000000000000
    Size.Height = 48.000000000000000000
    Size.PlatformDefault = False
    Text = 'Hola mundo'
    TextSettings.Font.Size = 18.000000000000000000
    OnClick = btnHolaMundoClick
  end
end
